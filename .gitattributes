# Normalise line endings so that a checkout on Windows, macOS and Linux produces
# the same files (T-136). make and the shell entrypoints in the containers both
# fail on carriage returns, so those are pinned to LF regardless of platform.

* text=auto eol=lf

Makefile      text eol=lf
*.sh          text eol=lf
*.py          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
Dockerfile    text eol=lf
*.Dockerfile  text eol=lf

*.cmd         text eol=crlf
*.bat         text eol=crlf

# Media and packaged formats. text=auto would otherwise guess, and a line ending
# rewritten inside a video or a deck corrupts the file.
*.mp4 binary
*.webm binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.woff binary
*.woff2 binary
