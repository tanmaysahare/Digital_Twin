# Copy to .env to override the defaults in docker-compose.yml.
# No secret in this file is real. Nothing here reaches a control system.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=digitaltwin
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=3000

# Used by the non-Docker path in docs/technical/RUNNING.md
DIGITALTWIN_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/digitaltwin
DIGITALTWIN_LINE_CONFIG=config/lines/line2.yaml
