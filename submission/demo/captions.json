  "video": "submission\\demo\\recording.webm",
  "beats": [
    {
      "at_ms": 3613,
      "title": "A normal shift",
      "body": "Forty-two stations, live. The action region says nothing needs attention. All data on screen is simulated.",
      "hold_ms": 13000
    },
    {
      "at_ms": 17129,
      "title": "Six of these stations emit nothing",
      "body": "S33 to S37 and S42 are cross-hatched. The twin has no reading from them and does not pretend otherwise.",
      "hold_ms": 13000
    },
    {
      "at_ms": 32099,
      "title": "A bound, not a number",
      "body": "S34 reports an interval. The drawer names the five stations that share the bound and says none of them can be separated.",
      "hold_ms": 14000
    },
    {
      "at_ms": 46102,
      "title": "The blind spot becomes a costed recommendation",
      "body": "What is unknown, the device that would resolve it, the indicative cost, and the sentence saying the cost is our assumption.",
      "hold_ms": 14000
    },
    {
      "at_ms": 62233,
      "title": "A fixture wearing at S20",
      "body": "Cycle time drifting inside specification. No threshold alarm fires. EWMA and CUSUM must both signal before the twin says anything.",
      "hold_ms": 13000
    },
    {
      "at_ms": 77781,
      "title": "What would help, compared against doing nothing",
      "body": "Every option runs on the same replications from the same state. The footer states the replication count, the runtime and the state timestamp.",
      "hold_ms": 14000
    },
    {
      "at_ms": 93132,
      "title": "The stall forecaster has not cleared its gate",
      "body": "Precision 0.250 against a target of 0.60, median lead 5 minutes against 15. It is measured, it is published, and it is not tuned away.",
      "hold_ms": 14000
    },
    {
      "at_ms": 108664,
      "title": "Plan view",
      "body": "Where the constraint moved, the loss Pareto under its reconciliation line, and the sensor investment queue that leaves as a CSV.",
      "hold_ms": 13000
    },
    {
      "at_ms": 122694,
      "title": "Every predictor on this line is in shadow",
      "body": "The floor sees nothing from any of them. That is the trust ledger working, not the screen failing.",
      "hold_ms": 14000
    },
    {
      "at_ms": 138249,
      "title": "Program view",
      "body": "Site readiness scored from what each site emits, and a business case whose every assumption carries its source and its uncertainty.",
      "hold_ms": 13000
    },
    {
      "at_ms": 153960,
      "title": "The evidence",
      "body": "Every number below is in evaluation/metrics.json.",
      "hold_ms": 5000
    }
