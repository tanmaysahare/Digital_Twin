{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "custom-property-empty-line-before": null,
    "comment-empty-line-before": null,
    "declaration-empty-line-before": null,
    "color-hex-length": "long",
    "at-rule-no-unknown": [
      true,
      { "ignoreAtRules": ["tailwind", "layer", "apply", "screen", "variants"] }
    ],
    "function-disallowed-list": [
      "linear-gradient",
      "radial-gradient",
      "conic-gradient",
      "repeating-linear-gradient",
      "repeating-radial-gradient",
      "repeating-conic-gradient"
    ],
    "property-disallowed-list": ["backdrop-filter", "-webkit-backdrop-filter"],
    "media-feature-name-disallowed-list": ["prefers-color-scheme"],
    "declaration-property-value-disallowed-list": {
      "filter": ["/blur\\(/"],
      "background": ["/gradient\\(/"],
      "background-image": ["/gradient\\(/"],
      "mask-image": ["/gradient\\(/"]
    },
    "declaration-property-value-allowed-list": {
      "border-radius": ["0", "2px", "/^var\\(--radius/"],
      "border-top-left-radius": ["0", "2px", "/^var\\(--radius/"],
      "border-top-right-radius": ["0", "2px", "/^var\\(--radius/"],
      "border-bottom-left-radius": ["0", "2px", "/^var\\(--radius/"],
      "border-bottom-right-radius": ["0", "2px", "/^var\\(--radius/"],
      "box-shadow": ["none", "/^var\\(--elevation/"]
    }
  },
  "overrides": [
    {
      "files": ["src/**/*.css"],
      "rules": {
        "color-no-hex": true,
        "color-named": "never",
        "function-disallowed-list": [
          "linear-gradient",
          "radial-gradient",
          "conic-gradient",
          "repeating-linear-gradient",
          "repeating-radial-gradient",
          "repeating-conic-gradient",
          "rgb",
          "rgba",
          "hsl",
          "hsla"
        ]
      }
    },
    {
      "files": ["src/styles/tokens.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": [
          "linear-gradient",
          "radial-gradient",
          "conic-gradient",
          "repeating-linear-gradient",
          "repeating-radial-gradient",
          "repeating-conic-gradient"
        ]
      }
    }
  ]
}
